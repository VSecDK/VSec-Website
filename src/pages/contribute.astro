---
import Layout from '../layouts/Layout.astro';


const steps = [
  {
    n: '01',
    title: 'Join Discord',
    desc: 'Start by joining our Discord server and introduce yourself in #introductions. This is where most of the community\'s daily dialogue happens.',
  },
  {
    n: '02',
    title: 'Find a project or write a post',
    desc: 'You can contribute by writing a community post, helping with an existing project, or suggesting something new. Check out our GitHub organisation.',
  },
  {
    n: '03',
    title: 'Open an issue or a PR',
    desc: 'For projects: open an issue with your idea or submit a pull request. We review all contributions and provide feedback.',
  },
  {
    n: '04',
    title: 'Follow our code of conduct',
    desc: 'All contributors are expected to follow our code of conduct. This ensures a safe and inclusive environment.',
  },
];
---

<Layout title="Contribution Guide" description="How to contribute to the VSec community">

  <div class="max-w-6xl mx-auto px-6 py-16">
    <p class="section-label">// Open source</p>
    <h1 class="font-mono font-bold text-2xl sm:text-3xl md:text-4xl text-text-primary mb-2">Contribution Guide</h1>
    <p class="font-sans text-text-secondary mb-16 leading-relaxed">
      VSec is 100% community-driven. Here is how to get started contributing.
    </p>

    <!-- Steps -->
    <div class="flex flex-col gap-0">
      {steps.map((step, i) => (
        <div class="flex gap-6 relative">
          <!-- Timeline connector -->
          <div class="flex flex-col items-center flex-shrink-0">
            <div class="w-10 h-10 rounded border border-accent/30 bg-accent/5 flex items-center justify-center font-mono text-xs font-bold text-accent flex-shrink-0">
              {step.n}
            </div>
            {i < steps.length - 1 && (
              <div class="w-px flex-1 bg-border my-2"></div>
            )}
          </div>

          <div class:list={['pb-10', i === steps.length - 1 ? 'pb-0' : '']}>
            <h2 class="font-mono font-semibold text-text-primary mt-2 mb-2">{step.title}</h2>
            <p class="font-sans text-sm text-text-secondary leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Posting a job -->
    <div id="jobs" class="mt-16 pt-8 border-t border-border scroll-mt-20">
      <h2 class="font-mono font-bold text-xl text-text-primary mb-2">Posting a job</h2>
      <p class="font-sans text-sm text-text-secondary leading-relaxed mb-6 max-w-2xl">
        The job board lists cyber security roles in Denmark. Listings are free — VSec is a
        non-profit and takes no fee and no cut. Every listing is checked by a human before it
        goes live, whichever way it arrives.
      </p>

      <div class="grid sm:grid-cols-3 gap-4">
        <div class="card">
          <p class="font-mono text-sm text-text-primary mb-2">From Discord</p>
          <p class="font-sans text-sm text-text-secondary leading-relaxed">
            Run <code class="font-mono text-xs text-accent-text">/jobs suggest</code> in the
            community server with a link to the advert. The bot opens a pull request for review.
          </p>
        </div>
        <div class="card">
          <p class="font-mono text-sm text-text-primary mb-2">By pull request</p>
          <p class="font-sans text-sm text-text-secondary leading-relaxed">
            Add a Markdown file to
            <code class="font-mono text-xs text-accent-text">src/content/jobs/</code>.
            Copy <code class="font-mono text-xs text-accent-text">TEMPLATE.md.example</code>
            in that folder — it lists every field.
          </p>
        </div>
        <div class="card">
          <p class="font-mono text-sm text-text-primary mb-2">From your own tooling</p>
          <p class="font-sans text-sm text-text-secondary leading-relaxed">
            Job platforms and ATS integrations can post to the public submission API.
            See the <code class="font-mono text-xs text-accent-text">vsec-job-fetcher</code>
            README for the contract.
          </p>
        </div>
      </div>

      <p class="font-mono text-xs text-text-muted mt-5 leading-relaxed">
        Listings expire automatically — 60 days after posting unless the advert names a
        closing date. Recruiters are welcome for named roles at a named employer;
        anonymous "confidential client" adverts are not.
      </p>

      <div class="flex flex-wrap gap-4 mt-6">
        <a href="/jobs" class="btn-ghost text-sm">View the job board →</a>
      </div>
    </div>

    <!-- Valuable Contributors -->
    <div class="mt-16 pt-8 border-t border-border">
      <h2 class="font-mono font-bold text-xl text-text-primary mb-2">Valuable Contributors</h2>
      <div class="p-5 rounded-lg border border-dashed border-border">
        <p class="font-mono text-xs text-text-muted">// Function under development</p>
      </div>
    </div>

    <!-- Useful links -->
    <div class="mt-16 pt-8 border-t border-border space-y-4">
      <h2 class="font-mono font-bold text-xl text-text-primary">Useful links</h2>
      <div class="flex flex-wrap gap-4">
        <a href="https://github.com/VSecDK" target="_blank" rel="noopener noreferrer" class="btn-primary">GitHub organisation</a>
        <a href="https://discord.com/invite/XCUja4Q" target="_blank" rel="noopener noreferrer" class="btn-ghost">Discord</a>
        <a href="/about#code-of-conduct" class="btn-ghost">Code of conduct</a>
      </div>
    </div>
  </div>

</Layout>
