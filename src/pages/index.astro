---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import MemberCard from '../components/MemberCard.astro';
import { getIncidentTypeConfig } from '../lib/incident-types';
import { getOrgRepos } from '../lib/github';


const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// UTC on both sides — see the note in events.astro.
const todayStr = new Date().toISOString().slice(0, 10);
const events = (await getCollection('events'))
  .filter(e => e.data.date.toISOString().slice(0, 10) >= todayStr)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 2);

const tierOrder = { gold: 0, silver: 1, bronze: 2 } as const;
const tierStyle = {
  gold:   'border-sev-amber/40 bg-sev-amber/5 hover:border-yellow-500/50',
  silver: 'border-slate-400/30 bg-slate-400/5 hover:border-slate-400/50',
  bronze: 'border-orange-700/30 bg-orange-700/5 hover:border-orange-700/50',
} as const;
const tierLabel = { gold: '★ Gold', silver: '★ Silver', bronze: '★ Bronze' } as const;

const sponsors = (await getCollection('sponsors'))
  .sort((a, b) => tierOrder[a.data.tier] - tierOrder[b.data.tier]);

const communities = (await getCollection('communities'))
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));

const allMembers = await getCollection('members');

// Carousel roster: featured members first, then a random sample of the rest.
// Built here at build time and rendered as static HTML — the client script only
// toggles visibility, so no member-controlled string is ever parsed as markup.
const MEMBERS_PER_PAGE = 4;
const MEMBER_PAGES = 6;

function shuffle<T>(items: T[]): T[] {
  const out = [...items];
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

const carouselRoster = [
  ...allMembers.filter(m => m.data.featured),
  ...shuffle(allMembers.filter(m => !m.data.featured)),
].slice(0, MEMBERS_PER_PAGE * MEMBER_PAGES);

const memberPages = Array.from(
  { length: Math.ceil(carouselRoster.length / MEMBERS_PER_PAGE) },
  (_, i) => carouselRoster.slice(i * MEMBERS_PER_PAGE, (i + 1) * MEMBERS_PER_PAGE),
);

const allPosts = await getCollection('posts');
const allEvents = await getCollection('events');
const allIncidents = (await getCollection('incidents'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentCases = allIncidents.slice(0, 4);

// A failed lookup must not render as "0 Projects" — omit the stat instead.
const repoResult = await getOrgRepos();

const stats = [
  { value: allMembers.length,   label: 'Members' },
  { value: allPosts.length,     label: 'Posts' },
  { value: allEvents.length,    label: 'Events' },
  ...(repoResult.ok ? [{ value: repoResult.repos.length, label: 'Projects' }] : []),
  { value: communities.length,  label: 'Communities' },
  { value: allIncidents.length, label: 'Incidents' },
];
---

<Layout title="Home" description="VSec – The Danish non-profit infosec community">

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <!-- Grid background -->
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-100 pointer-events-none"></div>
    <!-- Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[300px] sm:w-[600px] h-[300px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-16 sm:py-24 md:py-36">
      <p class="section-label mb-6">// Danish infosec community</p>

      <h1 class="font-mono font-bold text-3xl sm:text-5xl md:text-7xl text-text-primary leading-[1.05] tracking-tight mb-6">
        We build<br />
        <span class="text-accent">security</span><br />
        together.
      </h1>

      <p class="font-sans text-lg text-text-secondary max-w-lg leading-relaxed mb-10">
        VSec is a non-profit community for Danish infosec professionals and enthusiasts.
        Share knowledge, participate in events, and be part of a strong network.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/posts" class="btn-primary">
          Read posts
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="https://discord.com/invite/XCUja4Q" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          Join on Discord
        </a>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap gap-8 mt-16 pt-8 border-t border-border">
        {stats.map(stat => (
          <div>
            <p class="font-mono font-bold text-2xl text-text-primary">{stat.value}</p>
            <p class="font-mono text-xs text-text-muted mt-0.5">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="section-label">// Community</p>
        <h2 class="font-mono font-bold text-2xl text-text-primary">Latest posts</h2>
      </div>
      <a href="/posts" class="font-mono text-sm text-accent-text hover:text-accent transition-colors duration-200">
        All posts →
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {posts.map(post => (
        <a href={`/posts/${post.id}`} class="card group flex flex-col gap-4">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.slice(0, 2).map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <h3 class="font-mono font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 leading-snug">
            {post.data.title}
          </h3>
          <p class="font-sans text-sm text-text-secondary leading-relaxed flex-1">
            {post.data.description}
          </p>
          <div class="flex items-center justify-between pt-2 border-t border-border">
            <span class="font-mono text-xs text-text-muted">{post.data.author}</span>
            {post.data.readingTime && (
              <span class="font-mono text-xs text-text-muted">{post.data.readingTime}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Members -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label">// Community</p>
          <h2 class="font-mono font-bold text-2xl text-text-primary">Verified members</h2>
        </div>
        <a href="/members" class="font-mono text-sm text-accent-text hover:text-accent transition-colors duration-200">
          All members &rarr;
        </a>
      </div>

      <!--
        Fully server-rendered. The client script only toggles the `hidden`
        attribute on these pre-rendered pages, so member-supplied text is never
        interpolated into markup at runtime.
      -->
      <div id="members-carousel" data-members-carousel>
        {memberPages.map((page, i) => (
          <div
            class="grid sm:grid-cols-2 gap-5"
            data-member-page={i}
            hidden={i !== 0}
          >
            {page.map(m => (
              <MemberCard
                name={m.data.name}
                handle={m.data.handle}
                bio={m.data.bio}
                avatar={m.data.avatar}
                discordAvatar={m.data.discordAvatar}
                github={m.data.github}
                twitter={m.data.twitter}
                linkedin={m.data.linkedin}
                website={m.data.website}
                ctftime={m.data.ctftime}
                roles={m.data.roles}
                verified={m.data.verified}
                featured={m.data.featured}
              />
            ))}
          </div>
        ))}
      </div>

      {memberPages.length > 1 && (
        <div class="flex justify-center items-center gap-4 mt-8">
          <div id="members-dots" class="flex items-center gap-2" role="group" aria-label="Member pages">
            {memberPages.map((_, i) => (
              <button
                type="button"
                class="mc-dot"
                data-member-dot={i}
                aria-label={`Show member page ${i + 1} of ${memberPages.length}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
          </div>

          <button
            type="button"
            id="members-playpause"
            class="font-mono text-[10px] uppercase tracking-widest text-text-muted hover:text-accent transition-colors duration-200 border border-border rounded px-2 py-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            aria-pressed="false"
          >Pause</button>
        </div>
      )}
    </div>
  </section>

  <script>
    // Visibility-only carousel: no markup is generated at runtime.
    const carousel = document.querySelector<HTMLElement>('[data-members-carousel]');
    const playPause = document.getElementById('members-playpause') as HTMLButtonElement | null;

    if (carousel) {
      const pages = Array.from(carousel.querySelectorAll<HTMLElement>('[data-member-page]'));
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-member-dot]'));
      const INTERVAL = 20000;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let current = 0;
      let timer: number | undefined;
      let paused = false;

      function show(index: number) {
        current = (index + pages.length) % pages.length;
        pages.forEach((page, i) => { page.hidden = i !== current; });
        dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === current)));
      }

      function stop() {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
      }

      function start() {
        stop();
        // Respect the user's motion preference and an explicit pause.
        if (paused || reduceMotion.matches || pages.length < 2) return;
        timer = window.setInterval(() => show(current + 1), INTERVAL);
      }

      function setPaused(next: boolean) {
        paused = next;
        if (playPause) {
          playPause.textContent = paused ? 'Play' : 'Pause';
          playPause.setAttribute('aria-pressed', String(paused));
        }
        start();
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => { show(i); start(); });
      });

      playPause?.addEventListener('click', () => setPaused(!paused));

      // Pause while the user is reading or tabbing through a card.
      carousel.addEventListener('pointerenter', stop);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('pointerleave', start);
      carousel.addEventListener('focusout', start);

      reduceMotion.addEventListener('change', start);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop(); else start();
      });

      if (reduceMotion.matches && playPause) playPause.hidden = true;
      start();
    }
  </script>

  <!-- Upcoming events -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label">// Calendar</p>
          <h2 class="font-mono font-bold text-2xl text-text-primary">Upcoming events</h2>
        </div>
        <a href="/events" class="font-mono text-sm text-accent-text hover:text-accent transition-colors duration-200">
          All events →
        </a>
      </div>

      <div class="flex flex-col gap-4">
        {events.map(event => (
          <div class="card flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
            <div class="flex-shrink-0 font-mono text-center md:text-left">
              <p class="text-2xl font-bold text-accent">
                {event.data.date.toLocaleDateString('en-GB', { day: '2-digit' })}
              </p>
              <p class="text-xs text-text-muted uppercase tracking-widest">
                {event.data.date.toLocaleDateString('en-GB', { month: 'short' })}
              </p>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-1">
                <span class="tag">{event.data.type}</span>
                <span class="font-mono text-xs text-text-muted">{event.data.location}</span>
              </div>
              <h3 class="font-mono font-semibold text-text-primary" lang={event.data.lang}>{event.data.title}</h3>
              <p class="font-sans text-sm text-text-secondary mt-1" lang={event.data.lang}>{event.data.description}</p>
            </div>
            {event.data.link && (
              <a
                href={event.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-xs flex-shrink-0"
              >
                Register
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest incidents -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label">// CTI League</p>
          <h2 class="font-mono font-bold text-2xl text-text-primary">Latest incidents</h2>
          <p class="font-sans text-sm text-text-secondary mt-1">Documented Danish cybersecurity incidents.</p>
        </div>
        <a href="/incidents" class="font-mono text-sm text-accent-text hover:text-accent transition-colors duration-200">
          All incidents →
        </a>
      </div>

      <div class="flex flex-col gap-2">
        {recentCases.map(entry => {
          const tc = getIncidentTypeConfig(entry.data.type);
          return (
            <a
              href={`/incidents/${entry.id}`}
              class="card group flex items-start gap-4 hover:border-accent/20 transition-colors duration-200"
            >
              <div class="flex-shrink-0 font-mono text-xs text-text-muted pt-0.5 w-24">
                {entry.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </div>
              <div class="flex-1 min-w-0 flex flex-wrap items-center gap-2">
                <span class:list={['tag text-[10px] py-0 flex-shrink-0', tc.style]}>{tc.label}</span>
                <span class="font-mono font-semibold text-sm text-text-primary group-hover:text-accent transition-colors duration-200 truncate">
                  {entry.data.company}
                </span>
                {entry.data.sector && (
                  <span class="font-sans text-xs text-text-muted hidden sm:inline">{entry.data.sector}</span>
                )}
              </div>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" class="text-text-muted group-hover:text-accent flex-shrink-0 mt-0.5 transition-colors duration-200">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Communities -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="section-label">// Network</p>
          <h2 class="font-mono font-bold text-2xl text-text-primary">Communities</h2>
          <p class="font-sans text-sm text-text-secondary mt-1">Other places in the security community worth knowing.</p>
        </div>
        <a href="/communities" class="font-mono text-sm text-accent-text hover:text-accent transition-colors duration-200">
          See all →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {communities.map(c => (
          <a
            href={c.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="card group flex items-start gap-4"
          >
            <!-- Logo / fallback (index) -->
            <div class="flex-shrink-0 w-10 h-10 rounded border border-border bg-bg-elevated flex items-center justify-center overflow-hidden">
              {c.data.logo ? (
                <img
                  src={c.data.logo}
                  alt={c.data.name}
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                  class="w-6 h-6 object-contain"
                  data-avatar
                />
                <span class="font-mono font-bold text-sm text-accent hidden items-center justify-center w-full h-full">
                  {c.data.name.charAt(0)}
                </span>
              ) : (
                <span class="font-mono font-bold text-sm text-accent">
                  {c.data.name.charAt(0)}
                </span>
              )}
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="font-mono font-semibold text-sm text-text-primary group-hover:text-accent transition-colors duration-200 truncate">
                  {c.data.name}
                </h3>
                {c.data.featured && (
                  <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-accent" title="Featured"></span>
                )}
              </div>
              <p class="font-sans text-xs text-text-secondary leading-relaxed line-clamp-2">
                {c.data.description}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {c.data.tags.slice(0, 3).map(tag => (
                  <span class="tag text-[10px] py-0">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="border-t border-border bg-bg-surface">
    <div class="max-w-6xl mx-auto px-6 py-20 text-center">
      <p class="section-label justify-center flex mb-4">// Get involved</p>
      <h2 class="font-mono font-bold text-3xl md:text-4xl text-text-primary mb-4">
        Ready to contribute?
      </h2>
      <p class="font-sans text-text-secondary max-w-md mx-auto mb-8 leading-relaxed">
        VSec thrives on community. Share your knowledge, write a post, or help with a project.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contribute" class="btn-primary">Contribution guide</a>
        <a href="/about" class="btn-ghost">About VSec</a>
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <p class="section-label justify-center flex mb-3">// Thank you for your support</p>
      <p class="font-sans text-sm text-text-secondary max-w-lg mx-auto leading-relaxed mb-10">
        VSec is a non-profit community run by volunteers. We are grateful for the support from
        our sponsors, who make it possible to host events, run infrastructure, and grow
        as a community.
      </p>

      {sponsors.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-6">
          {sponsors.map(s => (
            <a
              href={s.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'flex flex-col items-center gap-3 px-8 py-5 rounded-lg border transition-colors duration-300',
                tierStyle[s.data.tier],
              ]}
            >
              {s.data.logo ? (
                <img src={s.data.logo} alt={s.data.name} width="160" height="32" loading="lazy" decoding="async" class="h-8 object-contain opacity-80 hover:opacity-100 transition-opacity" />
              ) : (
                <span class="font-mono font-semibold text-text-primary">{s.data.name}</span>
              )}
              <span class="font-mono text-[10px] tracking-widest uppercase text-text-muted">
                {tierLabel[s.data.tier]}
              </span>
            </a>
          ))}
        </div>
      )}

      <div class="mt-10 space-y-2">
        <p class="font-mono text-xs text-text-muted">Interested in sponsoring VSec?</p>
        <a href="mailto:info@vsec.dk" class="font-mono text-xs text-accent-text hover:text-accent transition-colors duration-200">
          info@vsec.dk →
        </a>
      </div>
    </div>
  </section>

</Layout>
