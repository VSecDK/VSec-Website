---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
const links = [
  { href: '/posts', label: 'Posts' },
  { href: '/learning', label: 'Learning' },
  { href: '/incidents', label: 'Incidents' },
  { href: '/projects', label: 'Projects' },
  { href: '/events', label: 'Events' },
  { href: '/members', label: 'Members' },
  { href: '/communities', label: 'Communities' },
  { href: '/contribute', label: 'Contribute' },
  { href: '/about', label: 'About' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-bg-base/80 backdrop-blur-md">
  <nav class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between" aria-label="Main navigation">

    <a href="/" class="font-mono font-semibold text-text-primary tracking-tight flex items-center gap-1.5 group">
      <span class="text-accent group-hover:text-accent-text transition-colors duration-200">[</span>
      <span class="group-hover:text-accent transition-colors duration-200">VSec</span>
      <span class="text-accent group-hover:text-accent-text transition-colors duration-200">]</span>
    </a>

    <!-- Desktop menu -->
    <ul class="hidden lg:flex items-center gap-0.5">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-mono text-[13px] px-2 py-1.5 rounded transition-colors duration-200',
              current.startsWith(link.href)
                ? 'text-accent bg-accent/8'
                : 'text-text-secondary hover:text-text-primary hover:bg-white/4',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="https://discord.com/invite/XCUja4Q"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-xs py-2 px-4 hidden sm:inline-flex"
      >
        Discord
        <Icon name="external-link" size={12} />
      </a>

      <!-- Hamburger (mobile) -->
      <button
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
        class="lg:hidden flex flex-col justify-center items-center w-9 h-9 rounded border border-border bg-bg-surface hover:border-accent/30 transition-colors duration-200"
      >
        <span class="hamburger-bar block w-4 h-px bg-text-secondary transition-[transform,opacity] duration-200 origin-center"></span>
        <span class="hamburger-bar block w-4 h-px bg-text-secondary transition-[transform,opacity] duration-200 mt-1.5"></span>
        <span class="hamburger-bar block w-4 h-px bg-text-secondary transition-[transform,opacity] duration-200 mt-1.5"></span>
      </button>
    </div>

  </nav>

  <!-- Mobile dropdown -->
  <div
    id="nav-mobile"
    class="lg:hidden hidden border-t border-border bg-bg-base"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul class="max-w-6xl mx-auto px-6 py-3 flex flex-col gap-1">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-mono text-sm px-3 py-2.5 rounded flex items-center transition-colors duration-200',
              current.startsWith(link.href)
                ? 'text-accent bg-accent/8'
                : 'text-text-secondary hover:text-text-primary hover:bg-white/4',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="sm:hidden pt-2 mt-1 border-t border-border">
        <a
          href="https://discord.com/invite/XCUja4Q"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm px-3 py-2.5 rounded flex items-center gap-2 text-accent-text hover:text-accent transition-colors duration-200"
        >
          Discord
          <Icon name="external-link" size={12} />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const mobile = document.getElementById('nav-mobile');
  if (!toggle || !mobile) throw new Error('Nav elements not found');
  const bars = Array.from(toggle.querySelectorAll<HTMLElement>('.hamburger-bar'));

  function closeMenu() {
    mobile!.classList.add('hidden');
    bars.forEach(b => b.style.cssText = '');
    toggle!.setAttribute('aria-expanded', 'false');
    toggle!.setAttribute('aria-label', 'Open menu');
  }

  toggle.addEventListener('click', () => {
    const open = mobile!.classList.toggle('hidden') === false;
    toggle!.setAttribute('aria-expanded', String(open));
    toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    if (open) {
      bars[0].style.cssText = 'transform:translateY(8px) rotate(45deg)';
      bars[1].style.cssText = 'opacity:0';
      bars[2].style.cssText = 'transform:translateY(-8px) rotate(-45deg)';
      const firstLink = mobile!.querySelector('a');
      if (firstLink) firstLink.focus();
    } else {
      bars[0].style.cssText = '';
      bars[1].style.cssText = '';
      bars[2].style.cssText = '';
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle!.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle!.focus();
    }
  });

  // Close on navigation
  mobile.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', closeMenu)
  );
</script>
