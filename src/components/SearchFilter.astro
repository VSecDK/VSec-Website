---
/**
 * Text search, and optionally one row of single-select chips per filter group.
 *
 * Items opt in with `data-search-text` (lowercased haystack) and, for the
 * chips, `data-search-tags` (comma-separated, lowercased). Pages that pass no
 * `filters` keep the plain search box they had before.
 *
 * An item carrying `data-unavailable` is never shown and never counted — the
 * jobs page uses it to retire a listing that expired since the last build.
 */
export interface FilterOption {
  value: string;
  label: string;
}

export interface FilterGroup {
  /** Stable id, used for the group's chip container. */
  id: string;
  /** Visible group label, also the accessible group name. */
  label: string;
  /** Label for the "no filter" chip. */
  allLabel?: string;
  options: FilterOption[];
}

interface Props {
  listId: string;
  placeholder?: string;
  filters?: FilterGroup[];
}

const { listId, placeholder = 'Search...', filters = [] } = Astro.props;
const uid = `sf-${listId}`;
---

<div class="mb-8 search-filter" id={uid} data-list-id={listId}>
  <div class="relative">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="text"
      id={`${uid}-input`}
      placeholder={placeholder}
      autocomplete="off"
      aria-label={placeholder}
      class="w-full font-mono text-sm bg-bg-elevated border border-border-strong rounded-lg px-4 py-2.5 pl-9 pr-10 text-text-primary placeholder:text-text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus:border-accent transition-colors duration-200"
    />
    <button
      id={`${uid}-clear`}
      class="absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-text-muted hover:text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded transition-colors duration-150 hidden"
      aria-label="Clear search"
    >✕</button>
  </div>

  {filters.length > 0 && (
    <div class="mt-4 flex flex-col gap-3">
      {filters.map(group => (
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label={group.label}>
          <span class="font-mono text-[10px] text-text-muted tracking-widest uppercase w-full sm:w-auto sm:mr-1">
            {group.label}
          </span>
          <button
            type="button"
            class="filter-chip"
            data-filter-group={group.id}
            data-filter-value="all"
            data-active="true"
            aria-pressed="true"
          >{group.allLabel ?? 'All'}</button>
          {group.options.map(option => (
            <button
              type="button"
              class="filter-chip"
              data-filter-group={group.id}
              data-filter-value={option.value}
              data-active="false"
              aria-pressed="false"
            >{option.label}</button>
          ))}
        </div>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.search-filter').forEach(container => {
    const uid = container.id;
    const listId = container.dataset.listId!;
    const input = document.getElementById(`${uid}-input`) as HTMLInputElement | null;
    const clearBtn = document.getElementById(`${uid}-clear`);
    const list = document.getElementById(listId);
    if (!list || !input || !clearBtn) return;

    const chips = Array.from(container.querySelectorAll<HTMLButtonElement>('[data-filter-group]'));
    const selected = new Map<string, string>();
    chips.forEach(chip => selected.set(chip.dataset.filterGroup!, 'all'));

    const emptyMsg = document.createElement('p');
    emptyMsg.className = 'font-mono text-sm text-text-muted text-center py-12';
    emptyMsg.textContent = 'No results found.';
    emptyMsg.style.display = 'none';
    list.after(emptyMsg);

    function matchesChips(item: HTMLElement): boolean {
      if (selected.size === 0) return true;
      const tags = (item.getAttribute('data-search-tags') || '')
        .toLowerCase()
        .split(',')
        .map(tag => tag.trim())
        .filter(Boolean);
      for (const value of selected.values()) {
        if (value !== 'all' && !tags.includes(value)) return false;
      }
      return true;
    }

    function applyFilter() {
      const query = input!.value.trim().toLowerCase();
      const items = list!.querySelectorAll<HTMLElement>('[data-search-text]');
      let visibleCount = 0;

      items.forEach(item => {
        // A listing retired client-side stays hidden whatever the filters say.
        const available = !item.hasAttribute('data-unavailable');
        const text = (item.getAttribute('data-search-text') || '').toLowerCase();
        const show = available && (!query || text.includes(query)) && matchesChips(item);
        item.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      list!.querySelectorAll<HTMLElement>('[data-search-section]').forEach(section => {
        const hasVisible = Array.from(section.querySelectorAll<HTMLElement>('[data-search-text]'))
          .some(el => el.style.display !== 'none');
        section.style.display = hasVisible ? '' : 'none';
      });

      emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
      clearBtn!.classList.toggle('hidden', !query);
      container.dispatchEvent(new CustomEvent('searchfilter:change', { detail: { visible: visibleCount } }));
    }

    input.addEventListener('input', applyFilter);

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const group = chip.dataset.filterGroup!;
        const value = chip.dataset.filterValue!;
        selected.set(group, selected.get(group) === value ? 'all' : value);
        chips
          .filter(other => other.dataset.filterGroup === group)
          .forEach(other => {
            const active = other.dataset.filterValue === selected.get(group);
            other.dataset.active = String(active);
            other.setAttribute('aria-pressed', String(active));
          });
        applyFilter();
      });
    });

    clearBtn.addEventListener('click', () => {
      input!.value = '';
      applyFilter();
      input!.focus();
    });

    // Lets a page re-run filtering after it marks items unavailable.
    container.addEventListener('searchfilter:refresh', () => applyFilter());
  });
</script>
