/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://cdn.discordapp.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# Notes on the policy above:
#   script-src/style-src need no 'unsafe-inline' — the build emits zero inline
#     <script> and <style>, so keep it that way (Astro bundles them to /_astro).
#   base-uri 'none' neutralises injected <base> tags.
#   img-src allows cdn.discordapp.com for bot-populated member avatars.
#   X-Frame-Options is a legacy fallback for frame-ancestors.
#   X-XSS-Protection is deliberately absent: the legacy auditor is removed from
#     current browsers and was itself exploitable where it is still honoured.

# Long-term cache for hashed Astro assets (fingerprinted filenames)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images served locally
/images/*
  Cache-Control: public, max-age=2592000

# Fonts and favicons
/favicon.svg
  Cache-Control: public, max-age=86400

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
